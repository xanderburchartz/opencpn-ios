+// iOS: labels of buttons, checkboxes and radio buttons without mnemonic letter.
+// On iOS Qt underlined the letter after "&" ("_Help", "_OK"), which is pointless
+// without a keyboard. "&&" (a literal &) stays "&&" for Qt.
+inline QString wxQtConvertLabel( const wxString &label )
+{
+#ifdef Q_OS_IOS
+    wxString out;
+    for ( size_t i = 0; i < label.length(); i++ )
+    {
+        if ( label[i] == '&' )
+        {
+            if ( i + 1 < label.length() && label[i + 1] == '&' )
+            {
+                out += "&&";
+                i++;
+            }
+            continue;
+        }
+        out += label[i];
+    }
+    return wxQtConvertString( out );
+#else
+    return wxQtConvertString( label );
+#endif
+}
