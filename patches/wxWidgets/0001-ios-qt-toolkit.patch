+// opencpn-ios: labels van knoppen, vinkjes en rondjes zonder sneltoetsletter.
+// Qt tekende op iOS een streep onder de letter na "&" ("_Help", "_OK"); zonder
+// toetsenbord zinloos. "&&" (een echte &) blijft "&&" voor Qt.
+inline QString wxQtConvertLabel( const wxString &label )
+{
+#ifdef Q_OS_IOS
+    wxString out;
+    for ( size_t i = 0; i < label.length(); i++ )
+    {
+        if ( label[i] == '&' )
+        {
+            if ( i + 1 < label.length() && label[i + 1] == '&' )
+            {
+                out += "&&";
+                i++;
+            }
+            continue;
+        }
+        out += label[i];
+    }
+    return wxQtConvertString( out );
+#else
+    return wxQtConvertString( label );
+#endif
+}
