From 10af87f6e9edaf08f0957d3a0a7f4b87d506f017 Mon Sep 17 00:00:00 2001
From: Xander Burchartz <210020462+xanderburchartz@users.noreply.github.com>
Date: Sat, 14 Nov 2026 12:50:09 +0100
Subject: [PATCH 30/32] wmm_pi: do not send the magnetic variation to the bus
 on iOS

The plugin sends PGN 127258 every second once an NMEA 2000 connection has
output enabled. On iOS the plugin sends nothing to the bus; the variation
stays available inside OpenCPN through HVD.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 plugins/wmm_pi/src/wmm_pi.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/plugins/wmm_pi/src/wmm_pi.cpp b/plugins/wmm_pi/src/wmm_pi.cpp
index 1b6eea99d..d706097e7 100644
--- a/plugins/wmm_pi/src/wmm_pi.cpp
+++ b/plugins/wmm_pi/src/wmm_pi.cpp
@@ -990,6 +990,11 @@ void wmm_pi::SendBoatVarHVD(double d_var) {
 }
 
 void wmm_pi::SendPGN127258(double d_var) {
+#ifdef __OCPN__IOS__
+  // iOS: send nothing to the NMEA 2000 bus unprompted. The variation stays
+  // available inside OpenCPN through HVD.
+  return;
+#endif
   // Send Magnetic Variation as PGN 127258 Magnetic Variation
   double var_rad = d_var * (M_PI / 180.0);
   // Calculate the number of days since the Unix epoch
