 void MyFrame::ODoSetSize() {
+#ifdef __OCPN__IOS__
+  // iOS: no reentry. On device rotation, building the status bar below triggers
+  // a new resize, which rebuilt the status bar in the middle of the first build
+  // (crash). The last size is processed once more right afterwards (not via
+  // CallAfter: that left a half-black screen during rotation until the next
+  // event loop iteration). At most 3 extra rounds.
+  static bool s_inSetSize = false;
+  static bool s_again = false;
+  if (s_inSetSize) {
+    s_again = true;
+    return;
+  }
+  struct Reset {
+    ~Reset() { s_inSetSize = false; }
+  } reset;
+  for (int round = 0; round < 4; round++) {
+    s_inSetSize = true;
+    s_again = false;
+    ODoSetSizeBody();
+    if (!s_again) break;
+  }
+}
+
+void MyFrame::ODoSetSizeBody() {
+#endif
   int x, y;
   GetClientSize(&x, &y);
   //      Resize the children
@@ -2107,7 +2174,7 @@ void MyFrame::ODoSetSize() {
     font_size =
