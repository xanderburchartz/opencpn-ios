   if (sz.y > sz.x)  // Portait mode
     ratio = 0.8;
 
+#ifdef __OCPN__IOS__
+  // iOS: the estimate above assumes the whole options page and ignores our
+  // header bar; the list got 475 pt and "Update" fell below the screen. Use a
