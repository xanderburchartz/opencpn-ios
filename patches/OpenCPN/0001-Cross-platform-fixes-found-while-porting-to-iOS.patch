diff --git a/gui/include/gui/shaders.h b/gui/include/gui/shaders.h
index a1b016eae..3244d0422 100644
--- a/gui/include/gui/shaders.h
+++ b/gui/include/gui/shaders.h
@@ -137,14 +137,18 @@ public:
   }
 
   void SetAttributePointerf(const char *name, float *value) {
+    // Disable VBO's (vertex buffer objects) for attributes. This must happen
+    // before glVertexAttribPointer: the pointer is bound to the VBO that is
+    // bound at that moment, and a client pointer would otherwise be read as an
+    // offset into a leftover VBO (wrong vertices or a crash, seen after
+    // radar_pi "Hide Radar").
+    glBindBuffer(GL_ARRAY_BUFFER, 0);
+    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, 0);
+
     GLint aloc = glGetAttribLocation(programId_, name);
     glVertexAttribPointer(aloc, 2, GL_FLOAT, GL_FALSE, 2 * sizeof(float),
                           value);
     glEnableVertexAttribArray(aloc);
-
-    // Disable VBO's (vertex buffer objects) for attributes.
-    glBindBuffer(GL_ARRAY_BUFFER, 0);
-    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, 0);
   }
 
   GLuint programId() const { return programId_; }
diff --git a/gui/src/chcanv.cpp b/gui/src/chcanv.cpp
index cc0c35425..096f19931 100644
--- a/gui/src/chcanv.cpp
+++ b/gui/src/chcanv.cpp
@@ -6947,19 +6947,19 @@ void ChartCanvas::AlertDraw(ocpnDC &dc) {
 void ChartCanvas::UpdateShips() {
   //  Get the rectangle in the current dc which bounds the "ownship" symbol
 
-  wxClientDC dc(this);
-  // Sometimes during startup the dc x or y size is zero, which causes the
-  // bitmap creation to fail. Just skip the update in this case.
-  if (!dc.IsOk() || dc.GetSize().x < 1 || dc.GetSize().y < 1) return;
+  // Only the window size is needed. GetClientSize gives the same size without
+  // a wxClientDC outside a paint event (which crashes under wxQt).
+  wxSize dc_size = GetClientSize();
+  if (dc_size.x <= 0 || dc_size.y <= 0) return;
 
-  wxBitmap test_bitmap(dc.GetSize().x, dc.GetSize().y);
+  wxBitmap test_bitmap(dc_size.x, dc_size.y);
   if (!test_bitmap.IsOk()) return;
 
   wxMemoryDC temp_dc(test_bitmap);
 
   temp_dc.ResetBoundingBox();
   temp_dc.DestroyClippingRegion();
-  temp_dc.SetClippingRegion(0, 0, dc.GetSize().x, dc.GetSize().y);
+  temp_dc.SetClippingRegion(0, 0, dc_size.x, dc_size.y);
 
   // Draw the ownship on the temp_dc
   ocpnDC ocpndc = ocpnDC(temp_dc);
@@ -6998,12 +6998,10 @@ void ChartCanvas::UpdateAlerts() {
   //  Get the rectangle in the current dc which bounds the detected Alert
   //  targets
 
-  //  Use this dc
-  wxClientDC dc(this);
-
-  // Get dc boundary
+  // No wxClientDC (crashes under wxQt outside paint events); only the size
+  // is needed.
   int sx, sy;
-  dc.GetSize(&sx, &sy);
+  GetClientSize(&sx, &sy);
 
   //  Need a bitmap
   wxBitmap test_bitmap(sx, sy, -1);
@@ -7049,12 +7047,10 @@ void ChartCanvas::UpdateAIS() {
 
   //  Get the rectangle in the current dc which bounds the detected AIS targets
 
-  //  Use this dc
-  wxClientDC dc(this);
-
-  // Get dc boundary
+  // No wxClientDC (crashes under wxQt outside paint events); only the size
+  // is needed.
   int sx, sy;
-  dc.GetSize(&sx, &sy);
+  GetClientSize(&sx, &sy);
 
   wxRect ais_rect;
 
@@ -9285,8 +9281,12 @@ bool ChartCanvas::MouseEventProcessObjects(wxMouseEvent &event) {
         // Check displacement from touchdown to distinguish taps from pans.
         // On touchscreens, even a "tap" can have several pixels of jitter,
         // so use a generous threshold (20px) to avoid false positives.
-        int dx = x - m_touchdownPos.x;
-        int dy = y - m_touchdownPos.y;
+        // m_touchdownPos is in physical pixels (MouseEventProcessCanvas
+        // multiplies by m_displayScale), x/y here in logical pixels. Without
+        // the conversion every tap looked like a drag on a HiDPI screen and no
+        // route point was added.
+        int dx = x - wxRound(m_touchdownPos.x / m_displayScale);
+        int dy = y - wxRound(m_touchdownPos.y / m_displayScale);
         int dist2 = dx * dx + dy * dy;
         bool wasPan = (dist2 > 20 * 20);
 
@@ -9578,8 +9578,8 @@ bool ChartCanvas::MouseEventProcessObjects(wxMouseEvent &event) {
 
         // Skip if user panned (same logic as route handler above)
         {
-          int mdx = x - m_touchdownPos.x;
-          int mdy = y - m_touchdownPos.y;
+          int mdx = x - wxRound(m_touchdownPos.x / m_displayScale);
+          int mdy = y - wxRound(m_touchdownPos.y / m_displayScale);
           if (mdx * mdx + mdy * mdy > 20 * 20) return false;
         }
 
