+  // Same meaning per button; unknown names keep the bitmap.
+  static const char *const kSymbols[][2] = {
+      {"prev", "chevron.left"},
+      {"next", "chevron.right"},
+      {"altitude", "square.3.layers.3d"},
+      {"now", "clock.arrow.circlepath"},
+      {"zoomto", "viewfinder"},
+      {"curdata", "list.bullet.rectangle.fill"},
