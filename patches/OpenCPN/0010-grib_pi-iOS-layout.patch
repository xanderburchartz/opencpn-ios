+    if (QWidget *q = m_cRecordForecast->GetHandle()) {
+      q->setMaximumWidth(QWIDGETSIZE_MAX);
+      q->setMinimumWidth(need);
+    }
+    Layout();
+    Fit();
+  }
+#endif
 }
 
