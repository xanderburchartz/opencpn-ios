+// Werelddeel van het land uit de landinstelling (nl_NL -> NL -> Europe). Alleen voor de
+// volgorde en het openklappen; alle bronnen blijven in de lijst.
+static wxString RegionOfCountry(const wxString &cc) {
+  static const char *eu[] = {
+      "AD", "AL", "AT", "BA", "BE", "BG", "BY", "CH", "CY", "CZ", "DE", "DK", "EE",
+      "ES", "FI", "FO", "FR", "GB", "GI", "GR", "HR", "HU", "IE", "IS", "IT", "LI",
+      "LT", "LU", "LV", "MC", "MD", "ME", "MK", "MT", "NL", "NO", "PL", "PT", "RO",
+      "RS", "SE", "SI", "SK", "SM", "UA", "VA", nullptr};
+  static const char *na[] = {"US", "CA", "MX", "BS", "BM", "CU", "DO", "HT", "JM",
+                             "PR", "TT", "BZ", "CR", "GT", "HN", "NI", "PA", "SV",
+                             nullptr};
+  static const char *sa[] = {"AR", "BO", "BR", "CL", "CO", "EC", "GY", "PE", "PY",
+                             "SR", "UY", "VE", nullptr};
+  static const char *ao[] = {"AU", "NZ", "CN", "HK", "ID", "IN", "JP", "KR", "MY",
+                             "PH", "SG", "TH", "TW", "VN", "FJ", "PG", nullptr};
+  struct R {
+    const char **list;
+    const char *name;
+  } regions[] = {{eu, "Europe"},
+                 {na, "North America"},
+                 {sa, "South America"},
+                 {ao, "Asia and Oceania"}};
+  for (auto &r : regions)
+    for (const char **p = r.list; *p; ++p)
+      if (cc == *p) return r.name;
+  return wxEmptyString;
+}
