+  CPLErrorReset();
   int rc = pENCReader->Ingest();
+  if (rc != 0) {
+    // opencpn-ios: zonder deze regel staat er alleen "Cannot initialize ENC
+    // file" in het log, ook als de cel door een update is ingetrokken.
+    wxString why(CPLGetLastErrorMsg(), wxConvUTF8);
+    wxLogMessage("   S57 updates for %s failed (code %d): %s", FullPath, rc,
+                 why.IsEmpty() ? wxString("no reason given") : why);
+    // opencpn-ios: een ingetrokken cel ook aan de gebruiker melden (bel).
+    // De tekst komt uit S57Reader::ApplyUpdates (zelfde patch). Deze code
+    // kan in een werkthread van de kaartdatabase draaien; de melding gaat
+    // daarom via CallAfter naar de hoofdthread.
+    int cancel_update = 0;
+    if (wxTheApp &&
+        sscanf(why.mb_str(), "Update %d cancels this cell", &cancel_update) ==
+            1) {
+      wxString cell = wxFileName(FullPath).GetName();
+      wxTheApp->CallAfter([cell, cancel_update]() {
+        wxString msg = wxString::Format(
+            wxGetTranslation("ENC cell %s has been cancelled by its producer "
+                             "(update %d) and is not shown. Install a current "
+                             "chart for this area.",
+                             "opencpn"),
+            cell, cancel_update);
+        NotificationManager::GetInstance().AddNotification(
+            NotificationSeverity::kWarning, msg.ToStdString());
+      });
+    }
+  }
   return (rc == 0);  // true;
 }
 
