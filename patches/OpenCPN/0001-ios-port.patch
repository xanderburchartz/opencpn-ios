 void GribSettingsDialog::SetSettingsDialogSize() {
+#ifdef __OCPN__IOS__
+  // opencpn-ios: het venster wordt een schermvullend blad (app/ios/window_fit.cpp). De
+  // rekensom hieronder gaf de pagina's de breedte van de inhoud, hooguit scherm - 80 pt:
+  // rechts afgekapt ("knoper") en horizontaal schuiven (iPhone, 11 nov 2026). Hier: alleen
+  // verticaal schuiven en de breedte aan het blad laten; app/ios/fit_width.cpp deelt de
+  // regels in op de schermbreedte.
+  // Hoogte: wat er op het scherm overblijft naast kopbalk (window_fit), tabbalk en de
+  // knop Toepassen; met een minimum van 10 pt vielen de pagina's weg (alleen de knop).
+  int availH = 400, availW = -1;
+  if (wxWindow *frame = wxTheApp->GetTopWindow()) {
+    availH = frame->GetClientSize().y - 2 * m_sButton->GetSize().GetY() - 140;
+    availW = frame->GetClientSize().x;
+  }
+  availH = wxMax(200, availH);
+  // Breedte begrenzen: het tabbladvenster nam de breedte van de breedste pagina (GUI),
+  // en daarna liep Gegevens buiten het scherm (iPhone, 11 nov 2026).
+  if (availW > 100) m_nSettingsBook->SetMaxSize(wxSize(availW, -1));
+  for (size_t i = 0; i < m_nSettingsBook->GetPageCount(); i++) {
+    auto *sc = dynamic_cast<wxScrolledWindow *>(m_nSettingsBook->GetPage(i));
+    if (!sc) continue;
+    sc->SetScrollRate(0, 5);
+    // wxStaticBoxSizer neemt minstens de "beste" breedte van zijn groepsvak. In wxQt is
+    // dat de sizeHint van de QGroupBox, die de huidige breedte van het vak volgt; na een
+    // bredere indeling bleef het 421 pt en liep Gegevens na een bezoek aan GUI buiten het
+    // scherm (11 nov 2026). De kop is kort: een kleine beste breedte volstaat.
+    for (wxWindow *c : sc->GetChildren()) {
+      if (dynamic_cast<wxStaticBox *>(c))
+        c->CacheBestSize(wxSize(c->GetTextExtent(c->GetLabel()).x + 40, c->GetBestSize().y));
+      // Schuifregelaars: een vaste breedte van een eerdere, bredere indeling loslaten
+      // (Transparantie: 405 pt vast, de kaart liep buiten het scherm). Ze rekken mee.
+      if (dynamic_cast<wxSlider *>(c)) {
+        c->SetMinSize(wxSize(80, c->GetMinSize().y));
+        c->SetMaxSize(wxSize(-1, -1));
+        if (QWidget *q = c->GetHandle()) {
+          q->setMinimumWidth(0);
+          q->setMaximumWidth(QWIDGETSIZE_MAX);
+        }
+      }
+    }
+    int need = availH;
+    if (wxSizer *sz = sc->GetSizer()) need = wxMin(availH, sz->GetMinSize().y + 10);
+    sc->SetMinSize(wxSize(10, need));
+    if (availW > 100) sc->SetMaxSize(wxSize(availW, -1));
+    if (wxSizer *sz = sc->GetSizer()) sz->FitInside(sc);
+  }
+  Layout();
+  Refresh();
+  return;
+#endif
 #ifdef __OCPN__ANDROID__
   /*Sizing do not work with wxScolledWindow so we need to compute it
   using fixed X/Y margin to try to center nicely the dialog in the screen*/
@@ -1032,6 +1084,13 @@ void GribSettingsDialog::ShowSettings(int params, bool show) {
       // m_sIsoBarSpacing->SetMinSize(wxSize(70, -1));
       break;
     case ISO_LINE_SHORT:
+#ifdef __OCPN__IOS__
+      // opencpn-ios: het getal naast "Tussenafstand (…)" in plaats van een regel lager
+      // onder "Altijd zichtbaar" (iPhone, 13 nov 2026).
+      if (!m_fIsoBarSpacing->IsColGrowable(0)) m_fIsoBarSpacing->AddGrowableCol(0);
+      m_fIsoBarSpacing->Add(m_sIsoBarSpacing, 0, wxALIGN_CENTER_VERTICAL | wxALL, 5);
+      break;
+#endif
       m_fIsoBarVisibility->Add(m_sIsoBarSpacing, 0, 5,
                                wxTOP | wxLEFT | wxEXPAND);
