--- a/src/navico/NavicoReceive.cpp
+++ b/src/navico/NavicoReceive.cpp
@@ -520,7 +520,18 @@ SOCKET NavicoReceive::GetNewReportSocket() {
   } else {
     s << error;
     SetInfoStatus(s);
+#ifdef __OCPN__IOS__
+    // The receive loop retries this every select round for every network interface;
+    // without this throttle one in five log lines was this message. Only log new errors.
+    static thread_local wxString last_error;
+    if (error != last_error) {
+      last_error = error;
+      wxLogError(wxT("%s Unable to listen to socket: %s (further identical messages suppressed)"),
+                 m_ri->m_name.c_str(), error.c_str());
+    }
+#else
     wxLogError(wxT("%s Unable to listen to socket: %s"), m_ri->m_name.c_str(), error.c_str());
+#endif
   }
   return socket;
 }
