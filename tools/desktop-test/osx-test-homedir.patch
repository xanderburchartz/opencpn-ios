+#ifdef __WXOSX__
+#include <cstdio>
+#include <unistd.h>
+// Test build only (not part of the port series): refuse to run unless started
+// through the launcher that isolates HOME and the private data dir, so that a
+// test build never touches the regular OpenCPN installation.
+static const struct TestHomeGuard {
+  TestHomeGuard() {
+    const char* dir = getenv("OCPN_TEST_HOMEDIR");
+    const char* home = getenv("HOME");
+    if (!dir || !home || !*home ||
+        std::string(dir).rfind(std::string(home) + "/", 0) != 0) {
+      fprintf(stderr,
+              "Test build: start through Contents/MacOS/OpenCPN "
+              "(OCPN_TEST_HOMEDIR must be inside HOME)\n");
+      _exit(78);
+    }
+  }
+} test_home_guard;
+#endif
